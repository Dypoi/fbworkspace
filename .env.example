# ============================================================
# FB Workspace - contoh konfigurasi lokal
# Salin file ini menjadi .env lalu sesuaikan bila perlu.
# JANGAN menaruh password / cookie Facebook / token di sini.
# File .env sudah masuk .gitignore.
# ============================================================

# --- Dashboard ---
# Untuk laptop pribadi: biarkan 127.0.0.1 (hanya bisa diakses dari laptop itu).
# Jangan diganti 0.0.0.0 kecuali Anda benar-benar paham risikonya.
FBW_HOST=127.0.0.1
FBW_PORT=8501

# --- Database lokal (SQLite) ---
FBW_DB_PATH=data/fbworkspace.db

# --- Batas pengujian (dipakai sebagai nilai awal di dashboard) ---
FBW_MAX_POSTS=10
FBW_MAX_MINUTES=3

# --- Playwright (browser lokal, terlihat) ---
# false = jendela browser terlihat, sehingga Anda bisa login sendiri.
# JANGAN diubah ke true agar "lebih cepat" - Anda harus melihat apa yang terjadi.
FBW_BROWSER_HEADLESS=false
FBW_BROWSER_PROFILE_DIR=data/browser_profile
FBW_BROWSER_SLOW_MO_MS=120

# --- Ollama (opsional, lokal saja) ---
FBW_OLLAMA_URL=http://127.0.0.1:11434
FBW_OLLAMA_MODEL=qwen2.5:3b
FBW_OLLAMA_TIMEOUT=60
FBW_OLLAMA_MAX_INPUT_CHARS=2500
FBW_OLLAMA_ENABLED=false

# --- Keamanan ---
# Batas maksimum postingan yang boleh dibaca dalam satu sesi (pengaman).
FBW_HARD_MAX_POSTS=100

# --- Login Facebook ---
# Saat Facebook meminta login, browser DIBIARKAN TERBUKA selama ini agar Anda
# bisa login sendiri (OTP/checkpoint diselesaikan manual). 0 = langsung berhenti.
FBW_LOGIN_WAIT_SECONDS=180

# --- Ollama: kontrol keluaran (penting untuk qwen3) ---
# Qwen3 punya mode "thinking" yang bisa menghabiskan kuota token sebelum JSON
# selesai. Matikan (false) untuk ekstraksi JSON. Set true hanya bila perlu.
FBW_OLLAMA_THINK=false
# Batas token keluaran. Naikkan bila JSON sering terpotong.
FBW_OLLAMA_NUM_PREDICT=512

# --- Balas chat DM (Messenger) ---
# Nomor WhatsApp Anda untuk notifikasi eskalasi. Boleh 08... (otomatis jadi 62...).
FBW_WA_PHONE=081513839973
# Folder profil browser WhatsApp Web (scan QR sekali lewat scripts/wa_login.py).
FBW_WA_PROFILE_DIR=data/wa_profile
# Bawaannya uji kering: worker membaca & menyusun balasan TANPA mengirim.
# Ubah ke false hanya setelah Anda memeriksa hasil uji kering beberapa kali.
FBW_MESSENGER_DRY_RUN=true
FBW_MESSENGER_MAX_THREADS=8
FBW_MESSENGER_MAX_REPLIES=10
FBW_MESSENGER_GAP_SECONDS=45
FBW_MESSENGER_COOLDOWN_SECONDS=600
# Mode pantau: worker memeriksa DM baru berulang kali sampai Anda menekan berhenti.
# Notifikasi WhatsApp: true = tanpa jendela, false = jendela terlihat (lebih andal
# bila WhatsApp Web gagal dimuat headless di laptop Anda).
FBW_WA_HEADLESS=true
FBW_MESSENGER_WATCH=true
# Jeda antar pemeriksaan (detik). 30-60 cukup; jangan terlalu cepat.
FBW_MESSENGER_INTERVAL_SECONDS=30
# PIN pemulihan chat Messenger, HANYA kalau Facebook memintanya saat membuka chat.
# PENTING: file .env tidak masuk Git. Jangan menaruh PIN di kode/dokumen.
# Kosongkan bila Anda lebih suka mengisi PIN sendiri saat diminta.
# Format: 4-10 angka. Worker hanya mengisinya di layar "masukkan PIN pemulihan
# chat"; di layar checkpoint/verifikasi identitas/kode 2FA worker BERHENTI.
FBW_CHAT_PIN=
# false = worker tidak pernah mengisi PIN, hanya memberi tahu Anda.
FBW_CHAT_PIN_AUTO=true

# Variasi gaya bahasa balasan dengan Ollama (fakta harga/lokasi/WA tetap).
# Hanya jalan bila FBW_OLLAMA_ENABLED=true. false = pakai teks template apa adanya.
FBW_MESSENGER_AI_STYLE=true
